{
  "name": "@anyonce/conformance",
  "version": "0.0.0",
  "description": "Conformance runner and vectors for draft-ietf-httpapi-idempotency-key-header",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sns45/anyonce.git",
    "directory": "packages/conformance"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "bin": {
    "anyonce-conformance": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/runtime.ts src/cli.ts --format esm,cjs --dts --clean --shims",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@anyonce/fixture-hono": "workspace:*"
  }
}
