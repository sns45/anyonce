{
  "name": "@anyonce/anyq",
  "version": "0.0.0",
  "description": "anyq consumer middleware for anyonce idempotency",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sns45/anyonce.git",
    "directory": "packages/anyq"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@anyonce/core": "workspace:^",
    "@anyq/core": ">=0.5.0 <1"
  },
  "devDependencies": {
    "@anyonce/core": "workspace:*",
    "@anyq/core": "0.5.0",
    "@anyq/kafka": "0.5.0",
    "@anyq/memory": "0.5.0",
    "@anyq/redis-streams": "0.5.0",
    "@anyq/sqs": "0.5.0",
    "@aws-sdk/client-sqs": "^3.700.0"
  }
}
